# ===========================================
# FamilySync Environment Variables
# ===========================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# Then run setup:
#   ./scripts/setup.sh
# ===========================================

# Database (Neon Postgres)
# Get your connection string from https://console.neon.tech
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require"

# Authentication
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Google Places API (for local activity search) ~$275/mo
# https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=""

# YouTube Data API v3 (FREE - 10K units/day)
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=""

# Recreation.gov RIDB API (FREE)
# https://ridb.recreation.gov/docs
RIDB_API_KEY=""

# Push Notifications (Expo)
# https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=""

# AI Features — Claude API (for smart recommendations)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Mobile app API URL (set after deploying web to Vercel)
EXPO_PUBLIC_API_URL="http://localhost:3000"
